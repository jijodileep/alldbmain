{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "MySqlManager",
    "Audience": "MySqlManager",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Backup": {
    "RootPath": "data/backups",
    "TemporaryPath": "data/tmp",
    "GitWorkspacePath": "data/git",
    "DailyRetentionDays": 7,
    "Compression": "gzip",
    "EncryptionEnabled": true,
    "MasterKeyBase64": "",
    "MinimumFreeDiskPercentage": 15,
    "MySqlDumpPath": "mysqldump",
    "MySqlClientPath": "mysql",
    "GitPath": "git"
  },
  "Git": {
    "Enabled": true,
    "DefaultBranch": "main",
    "AllowHistoryRewrite": false
  },
  "Jobs": {
    "MaxConcurrentBackups": 2,
    "MaxConcurrentMigrations": 1,
    "PollIntervalSeconds": 5,
    "LeaseSeconds": 600,
    "MaxAttempts": 3
  },
  "Seed": {
    "AdminEmail": "admin@localhost",
    "AdminPassword": "",
    "SeedSampleServer": false
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Notifications": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "",
    "SmtpUseTls": true
  },
  "Secrets": {
    "Provider": "LocalEncrypted",
    "AzureKeyVaultUri": "",
    "AwsRegion": ""
  },
  "Storage": {
    "Type": "Local",
    "S3Bucket": "",
    "S3Region": "",
    "AzureBlobConnectionString": "",
    "AzureBlobContainer": "backups"
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*"
}
