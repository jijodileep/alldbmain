{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=mysql_manager;User=root;Password=CHANGE_ME;"
  },
  "Jwt": {
    "Issuer": "MySqlManager",
    "Audience": "MySqlManager",
    "SigningKey": "CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Backup": {
    "RootPath": "/data/backups",
    "TemporaryPath": "/data/tmp",
    "GitWorkspacePath": "/data/git",
    "DailyRetentionDays": 7,
    "Compression": "gzip",
    "EncryptionEnabled": true,
    "MasterKeyBase64": "CHANGE_ME_BASE64_32_BYTES",
    "MinimumFreeDiskPercentage": 15,
    "MySqlDumpPath": "mysqldump",
    "MySqlClientPath": "mysql",
    "GitPath": "git"
  },
  "Git": {
    "Enabled": true,
    "DefaultBranch": "main",
    "AllowHistoryRewrite": false
  },
  "Jobs": {
    "MaxConcurrentBackups": 2,
    "MaxConcurrentMigrations": 1,
    "PollIntervalSeconds": 5,
    "LeaseSeconds": 600,
    "MaxAttempts": 3
  },
  "Seed": {
    "AdminEmail": "admin@example.com",
    "AdminPassword": "",
    "SeedSampleServer": false
  },
  "Cors": {
    "Origins": [ "https://mysql-manager.example.com" ]
  },
  "Notifications": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "FromAddress": "",
    "SmtpUseTls": true
  },
  "Secrets": {
    "Provider": "LocalEncrypted",
    "AzureKeyVaultUri": "",
    "AwsRegion": ""
  },
  "Storage": {
    "Type": "Local",
    "S3Bucket": "",
    "S3Region": "",
    "AzureBlobConnectionString": "",
    "AzureBlobContainer": "backups"
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": ""
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  }
}
