FROM node:22-alpine AS build
WORKDIR /src
COPY src/Frontend/mysql-manager-web/package.json src/Frontend/mysql-manager-web/package-lock.json* ./
RUN npm install
COPY src/Frontend/mysql-manager-web/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html
